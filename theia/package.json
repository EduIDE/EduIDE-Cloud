    "**/@nx/devkit/minimatch": "^11.0.0",
    "**/@typescript-eslint/typescript-estree/minimatch": "^11.0.0",
    "serialize-javascript": "^7.0.5",
    "**/get-uri/basic-ftp": "^6.2.1",
    "**/@theia/filesystem/minimatch": "^11.0.1",
    "**/@theia/navigator/minimatch": "^11.0.1",
    "**/@theia/search-in-workspace/minimatch": "^11.0.1",
    "**/opfs-worker/minimatch": "^11.0.1",
    "**/@npmcli/arborist/minimatch": "^11.0.1",
